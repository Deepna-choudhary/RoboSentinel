<!DOCTYPE html>
<!-- saved from url=(0022)http://localhost:5174/ -->
<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    
    <link rel="icon" type="image/svg+xml" href="http://localhost:5174/favicon.svg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>robosentinel-frontend</title>
    <script type="module" crossorigin="" src="./dashboard-full_files/index-BbXUbRYc.js.download"></script>
    <link rel="stylesheet" crossorigin="" href="./dashboard-full_files/index-CYtdnGIL.css">
  </head>
  <body>
    <div id="root"><div class="app"><div class="header-section"><div><h1>🤖 RoboSentinel Dashboard</h1><div class="server-status online"><span class="status-dot"></span>Server: ONLINE</div></div><div class="header-actions"><button class="refresh-button">🔄 Refresh</button><button class="alert-button">🚨 Alerts</button></div></div><h2 class="section-title">🤖 Robot Statistics</h2><div class="stats-container"><div class="card"><h3>Total Robots</h3><p>1</p></div><div class="card"><h3>Healthy</h3><p>1</p></div><div class="card"><h3>Warning</h3><p>0</p></div><div class="card"><h3>Critical</h3><p>0</p></div></div><h2 class="section-title">📋 Task Statistics</h2><div class="stats-container"><div class="card"><h3>Total Tasks</h3><p>0</p></div><div class="card"><h3>Completed</h3><p>0</p></div><div class="card"><h3>Pending</h3><p>0</p></div><div class="card"><h3>In Progress</h3><p>0</p></div></div><h2 class="section-title">🚨 Alert Statistics</h2><div class="stats-container"><div class="card"><h3>Total Alerts</h3><p>0</p></div><div class="card"><h3>Critical Alerts</h3><p>0</p></div><div class="card"><h3>High Alerts</h3><p>0</p></div></div><div class="form-container"><h2>➕ Add New Robot</h2><form><input placeholder="Robot Code" required="" type="text" value=""><input placeholder="Robot Name" required="" type="text" value=""><input placeholder="Robot Model" required="" type="text" value=""><select><option value="ACTIVE">ACTIVE</option><option value="INACTIVE">INACTIVE</option><option value="IDLE">IDLE</option><option value="BUSY">BUSY</option></select><input placeholder="Battery Level (0-100)" min="0" max="100" required="" type="number" value=""><input placeholder="Location" required="" type="text" value=""><select><option value="HEALTHY">HEALTHY</option><option value="WARNING">WARNING</option><option value="CRITICAL">CRITICAL</option></select><button type="submit">Add Robot</button></form></div><div class="form-container"><h2>📋 Task Management</h2><form><select required=""><option value="">Select Healthy Robot</option><option value="1">R001 - Robo One</option></select><input placeholder="Task Name" required="" type="text" value=""><input placeholder="Task Description" required="" type="text" value=""><button type="submit">Assign Task</button><button type="button" class="clear-btn">Clear Task</button></form></div><h2 class="section-title">📋 Task List</h2><div class="table-container"><table><tbody><tr><td>No tasks found.</td></tr></tbody></table></div><div class="search-container"><h2>🔍 Search &amp; Filter Robots</h2><div class="search-row"><input placeholder="Search by Robot Name" type="text" value=""><button type="button">Search Name</button><input placeholder="Search by Robot Code" type="text" value=""><button type="button">Search Code</button></div><div class="search-row"><select><option value="">Select Status</option><option value="ACTIVE">ACTIVE</option><option value="INACTIVE">INACTIVE</option><option value="IDLE">IDLE</option><option value="BUSY">BUSY</option></select><button type="button">Filter Status</button><select><option value="">Select Health Status</option><option value="HEALTHY">HEALTHY</option><option value="WARNING">WARNING</option><option value="CRITICAL">CRITICAL</option></select><button type="button">Filter Health</button><button type="button" class="clear-btn">Clear All</button></div></div><h2 class="section-title">📋 Robot List</h2><div class="table-container"><table><thead><tr><th>ID</th><th>Robot Code</th><th>Name</th><th>Model</th><th>Status</th><th>Battery</th><th>Location</th><th>Health</th><th>Action</th></tr></thead><tbody><tr><td>1</td><td>R001</td><td>Robo One</td><td>RX-100</td><td><span class="status idle">IDLE</span></td><td><span class="battery healthy-battery">🔋 80%</span></td><td>Warehouse</td><td><span class="health healthy">HEALTHY</span></td><td><button type="button" class="edit-btn">Edit</button><button type="button" class="delete-btn">Delete</button></td></tr></tbody></table></div></div></div>
  

</body></html>